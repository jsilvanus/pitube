[Unit]
Description=PiTube YouTube Broadcast Manager
After=network-online.target pigateway.service

[Service]
WorkingDirectory=%h/apps/pitube
EnvironmentFile=%h/apps/pitube.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node dist/main.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
