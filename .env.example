# pitube configuration

# HTTP server
PITUBE_PORT=3105
PITUBE_HOST=0.0.0.0
PITUBE_API_KEY=

# pigateway connection
PITUBE_GATEWAY_URL=http://127.0.0.1:3100
PITUBE_GATEWAY_TOKEN=

# YouTube OAuth 2.0 Credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional fallback/static stream key (if not using dynamic liveStream API)
YOUTUBE_STREAM_KEY=

# Captions & Sync
# 30 s fixed delay per YouTube live captioning guidance
PITUBE_DELAY_MS=30000
# Max age before discarding stale transcripts (90s = 30s delay + 60s tolerance)
PITUBE_STALE_CAPTION_MS=90000
# YouTube caption ingestion endpoint (default: http://upload.youtube.com/closedcaption)
PITUBE_CAPTION_BASE_URL=http://upload.youtube.com/closedcaption

# Lifecycle & Polling
# Interval in ms to report status to pigateway
PITUBE_STATUS_INTERVAL_MS=5000
# TTL in ms announced to pigateway
PITUBE_STATUS_TTL_MS=15000
