{
  "openapi": "3.0.3",
  "info": {
    "title": "pitube",
    "version": "0.1.0",
    "description": "The Pi's only YouTube connection: broadcasts, streams, lifecycle and live captions. Never touches video."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3500"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "status",
        "summary": "State, level (idle|upcoming|testing|live|unhealthy|ended), selected broadcast, stream health, caption counters",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "operationId": "events",
        "summary": "Server-Sent Events: status, broadcast.status, broadcast.transition, stream.health, auth.health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {}
            }
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/auth/health": {
      "get": {
        "operationId": "auth-health",
        "summary": "Sign-in state without secrets (unchecked|ok|revoked|refresh_failed)",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/auth/check": {
      "post": {
        "operationId": "auth-check",
        "summary": "Refresh the token now and report health",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/broadcasts": {
      "get": {
        "operationId": "broadcasts-list",
        "summary": "List broadcasts",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "enum": [
                "upcoming",
                "active",
                "completed",
                "all"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/broadcasts/current": {
      "get": {
        "operationId": "broadcasts-current",
        "summary": "Selected broadcast, stream health and caption counters",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/broadcasts/select": {
      "post": {
        "operationId": "broadcasts-select",
        "summary": "Select a broadcast by id, or auto (within 60 minutes of now)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "broadcastId"
                ],
                "properties": {
                  "broadcastId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/broadcasts/create": {
      "post": {
        "operationId": "broadcasts-create",
        "summary": "Create a broadcast (default unlisted) and select it",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "privacy": {
                    "enum": [
                      "public",
                      "unlisted",
                      "private"
                    ]
                  },
                  "scheduledStartTime": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "autoSelect": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/broadcasts/{id}": {
      "patch": {
        "operationId": "broadcasts-update",
        "summary": "Change title, description, scheduled start or privacy",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "scheduledStartTime": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "privacy": {
                    "enum": [
                      "public",
                      "unlisted",
                      "private"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/broadcasts/privacy": {
      "post": {
        "operationId": "broadcasts-privacy",
        "summary": "Change privacy of the selected (or given) broadcast",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "privacy"
                ],
                "properties": {
                  "privacy": {
                    "enum": [
                      "public",
                      "unlisted",
                      "private"
                    ]
                  },
                  "broadcastId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/broadcasts/url": {
      "get": {
        "operationId": "broadcasts-url",
        "summary": "Watch and embed URLs, privacy and status",
        "parameters": [
          {
            "name": "broadcastId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/broadcasts/thumbnail": {
      "post": {
        "operationId": "broadcasts-thumbnail",
        "summary": "Upload a thumbnail (raw image body, max 2 MB). CLI: --file <path>",
        "parameters": [
          {
            "name": "broadcastId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": {},
            "image/png": {},
            "image/gif": {}
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/broadcasts/start": {
      "post": {
        "operationId": "broadcasts-start",
        "summary": "Refused until the stream receives data. ready -> testing -> live; to=testing stops at testing",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to": {
                    "enum": [
                      "testing",
                      "live"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/broadcasts/stop/request": {
      "post": {
        "operationId": "broadcasts-stop-request",
        "summary": "Ending step 1: returns a short-lived confirmToken, changes nothing",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/broadcasts/stop": {
      "post": {
        "operationId": "broadcasts-stop",
        "summary": "Ending step 2: complete the broadcast (confirmToken required when PITUBE_REQUIRE_STOP_CONFIRM=1)",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "confirmToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/streams": {
      "get": {
        "operationId": "streams-list",
        "summary": "List streams with status and health (never the key)",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/streams/create": {
      "post": {
        "operationId": "streams-create",
        "summary": "Create a reusable RTMP stream",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    },
    "/api/v1/ingest/apply": {
      "post": {
        "operationId": "ingest-apply",
        "summary": "Push the selected broadcast's RTMP target to piencoder (needs PITUBE_ENCODER_URL)",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "unit": {
                    "type": "integer"
                  },
                  "channel": {
                    "type": "integer",
                    "enum": [
                      1,
                      2
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error {error: string}"
          }
        }
      }
    }
  }
}
