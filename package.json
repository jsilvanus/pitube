{
  "name": "pitube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YouTube lifecycle handler and live caption sender for the pi* stack",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pitube": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "pitube": "tsx src/cli.ts",
    "openapi": "node scripts/build-openapi.mjs",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "lcyt": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0"
  },
  "pi": {
    "service": "pitube",
    "displayName": "PiTube",
    "layer": "Layer 4: Egress",
    "port": 3500,
    "ports": {},
    "healthEndpoint": "/health",
    "envPortVar": "PITUBE_PORT"
  }
}
